// 4M Diagnostics — Prisma data model
// Every test, package, doctor, price, and piece of business content is
// managed from the Admin Dashboard. Nothing here seeds fabricated medical data.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / staff / roles
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  ADMIN
  LAB_MANAGER
  RECEPTIONIST
  DOCTOR
  COLLECTION_STAFF
  ACCOUNTANT
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  permissions Json?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Staff / admin login identity. Patients authenticate separately via OTP (see Patient).
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff                   Staff?
  doctor                  Doctor?
  uploadedReports         ReportFile[]
  blogPosts               Blog[]
  auditLogs               AuditLog[]
  reportAccessLogs        ReportAccessLog[]
  assignedHomeCollections HomeCollection[]  @relation("AssignedStaff")

  @@index([roleId])
}

model Staff {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String    @unique
  designation  String?
  department   String?
  joiningDate  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id          String    @id @default(cuid())
  name        String
  mobile      String    @unique
  email       String?
  dateOfBirth DateTime?
  age         Int?
  gender      Gender?
  address     String?
  pincode     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings         Booking[]
  appointments     Appointment[]
  payments         Payment[]
  reports          Report[]
  invoices         Invoice[]
  notifications    Notification[]
  aiConversations  AIConversation[]
  reportAccessLogs ReportAccessLog[]

  @@index([mobile])
}

/// One-time passwords for patient mobile login and other OTP-gated flows.
enum OTPPurpose {
  PATIENT_LOGIN
  REPORT_ACCESS
}

model OTP {
  id         String     @id @default(cuid())
  mobile     String
  otpHash    String
  purpose    OTPPurpose
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([mobile, purpose])
}

// ---------------------------------------------------------------------------
// Doctors
// ---------------------------------------------------------------------------

model Doctor {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  qualification   String
  specialization  String
  photoUrl        String?
  biography       String?
  consultationFee Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@index([isActive])
}

model DoctorSchedule {
  id                  String   @id @default(cuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0 = Sunday .. 6 = Saturday
  startTime           String // "10:00"
  endTime             String // "18:00"
  slotDurationMinutes Int      @default(15)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Services (public-facing service catalogue, admin-controlled)
// ---------------------------------------------------------------------------

model Service {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Tests / packages
// ---------------------------------------------------------------------------

model TestCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tests Test[]
}

model Test {
  id                      String       @id @default(cuid())
  code                    String       @unique
  name                    String
  slug                    String       @unique
  categoryId              String
  category                TestCategory @relation(fields: [categoryId], references: [id])
  description             String?
  sampleType              String?
  preparation             String?
  fastingRequired         Boolean      @default(false)
  fastingDurationHours    Int?
  reportTimeHours         Int?
  homeCollectionAvailable Boolean      @default(true)
  price                   Decimal      @db.Decimal(10, 2)
  offerPrice              Decimal?     @db.Decimal(10, 2)
  isPopular               Boolean      @default(false)
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  parameters   TestParameter[]
  packageTests PackageTest[]
  bookingItems BookingItem[]

  @@index([categoryId])
  @@index([isActive, isPopular])
}

model TestParameter {
  id             String  @id @default(cuid())
  testId         String
  test           Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  name           String
  unit           String?
  referenceRange String?
  displayOrder   Int     @default(0)

  @@index([testId])
}

enum PackageCategory {
  GENERAL_HEALTH
  DIABETES
  THYROID
  WOMENS_HEALTH
  MENS_HEALTH
  SENIOR_CITIZEN
  HEART_HEALTH
  KIDNEY_HEALTH
  LIVER_HEALTH
}

model Package {
  id                      String          @id @default(cuid())
  name                    String
  slug                    String          @unique
  category                PackageCategory
  description             String?
  regularPrice            Decimal         @db.Decimal(10, 2)
  offerPrice              Decimal?        @db.Decimal(10, 2)
  preparation             String?
  homeCollectionAvailable Boolean         @default(true)
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  tests        PackageTest[]
  bookingItems BookingItem[]

  @@index([category])
  @@index([isActive])
}

model PackageTest {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  testId    String
  test      Test    @relation(fields: [testId], references: [id])

  @@unique([packageId, testId])
  @@index([testId])
}

// ---------------------------------------------------------------------------
// Bookings / home collection
// ---------------------------------------------------------------------------

enum BookingType {
  CENTER_VISIT
  HOME_COLLECTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  type          BookingType
  status        BookingStatus @default(PENDING)
  scheduledDate DateTime
  scheduledSlot String
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  totalAmount   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items          BookingItem[]
  homeCollection HomeCollection?
  payment        Payment?
  reports        Report[]

  @@index([patientId])
  @@index([status])
  @@index([bookingNumber])
}

model BookingItem {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  testId         String?
  test           Test?    @relation(fields: [testId], references: [id])
  packageId      String?
  package        Package? @relation(fields: [packageId], references: [id])
  priceAtBooking Decimal  @db.Decimal(10, 2)

  @@index([bookingId])
}

enum HomeCollectionStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  COLLECTION_STARTED
  SAMPLE_COLLECTED
  LAB_RECEIVED
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
}

model HomeCollection {
  id                  String               @id @default(cuid())
  bookingId           String               @unique
  booking             Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patientName         String
  mobile              String
  email               String?
  address             String
  landmark            String?
  pincode             String
  scheduledDate       DateTime
  scheduledSlot       String
  specialInstructions String?
  status              HomeCollectionStatus @default(PENDING)
  assignedStaffId     String?
  assignedStaff       User?                @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  collectedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([assignedStaffId])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(cuid())
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  date          DateTime
  time          String
  type          String            @default("CONSULTATION")
  fee           Decimal           @db.Decimal(10, 2)
  paymentStatus PaymentStatus     @default(PENDING)
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payment Payment?

  @@index([doctorId, date])
  @@index([patientId])
}

// ---------------------------------------------------------------------------
// Payments / invoices
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  patientId         String
  patient           Patient       @relation(fields: [patientId], references: [id])
  bookingId         String?       @unique
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  appointmentId     String?       @unique
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id])
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  method            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions PaymentTransaction[]
  invoice      Invoice?

  @@index([patientId])
  @@index([status])
}

model PaymentTransaction {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event      String
  rawPayload Json
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  gstAmount     Decimal? @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  pdfFileKey    String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([patientId])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  PROCESSING
  READY
  DOWNLOADED
}

model Report {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id])
  bookingId    String?
  booking      Booking?     @relation(fields: [bookingId], references: [id])
  testName     String
  status       ReportStatus @default(PROCESSING)
  reportDate   DateTime?
  readyAt      DateTime?
  downloadedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  files      ReportFile[]
  accessLogs ReportAccessLog[]

  @@index([patientId])
  @@index([status])
}

model ReportFile {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([reportId])
}

enum ReportAccessAction {
  VIEW
  DOWNLOAD
}

/// Every report view/download is logged for audit purposes.
model ReportAccessLog {
  id        String             @id @default(cuid())
  reportId  String
  report    Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patientId String?
  patient   Patient?           @relation(fields: [patientId], references: [id])
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  action    ReportAccessAction
  ipAddress String?
  createdAt DateTime           @default(now())

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Coupons / offers
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minAmount     Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bookings Booking[]

  @@index([code])
}

model Offer {
  id           String    @id @default(cuid())
  title        String
  description  String?
  imageUrl     String?
  linkUrl      String?
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(cuid())
  patientId String?
  patient   Patient?            @relation(fields: [patientId], references: [id])
  channel   NotificationChannel
  title     String
  message   String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([patientId])
}

model SMSLog {
  id               String   @id @default(cuid())
  mobile           String
  message          String
  provider         String?
  status           String
  providerResponse Json?
  createdAt        DateTime @default(now())

  @@index([mobile])
}

model WhatsAppLog {
  id               String   @id @default(cuid())
  mobile           String
  templateName     String?
  message          String
  status           String
  providerResponse Json?
  createdAt        DateTime @default(now())

  @@index([mobile])
}

model EmailLog {
  id               String   @id @default(cuid())
  toEmail          String
  subject          String
  templateName     String?
  status           String
  providerResponse Json?
  createdAt        DateTime @default(now())

  @@index([toEmail])
}

// ---------------------------------------------------------------------------
// FAQ / Blog
// ---------------------------------------------------------------------------

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  featuredImageUrl String?
  content          String
  authorId         String?
  author           User?      @relation(fields: [authorId], references: [id])
  seoTitle         String?
  seoDescription   String?
  keywords         String?
  status           BlogStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

enum AIKnowledgeCategory {
  TESTS
  PACKAGES
  PREPARATION
  HOME_COLLECTION
  APPOINTMENTS
  DOCTORS
  FAQS
  BUSINESS_INFO
  POLICIES
  OPENING_HOURS
}

model AIKnowledge {
  id        String              @id @default(cuid())
  category  AIKnowledgeCategory
  title     String
  content   String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([category, isActive])
}

model AIConversation {
  id        String    @id @default(cuid())
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id])
  sessionId String    @unique
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages AIMessage[]
}

enum AIMessageRole {
  USER
  ASSISTANT
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Audit / settings
// ---------------------------------------------------------------------------

enum AuditResult {
  SUCCESS
  FAILURE
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  action      String
  module      String
  description String?
  ipAddress   String?
  result      AuditResult
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([module, action])
}

/// Key/value store for site-wide content that must never be hard-coded
/// (business info, opening hours, policy text, etc.), editable from the Admin Dashboard.
model WebsiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
